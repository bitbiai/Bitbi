{
  "$schema": "../workers/contact/node_modules/wrangler/config-schema.json",
  "name": "bitbi-frontend",
  "main": "index.mjs",
  "compatibility_date": "2026-09-03",
  "no_bundle": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/css/*",
      "!/js/*",
      "!/fonts/*"
    ]
  }
}
