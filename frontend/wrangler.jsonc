{
  "$schema": "../workers/contact/node_modules/wrangler/config-schema.json",
  "name": "bitbi-frontend",
  "main": "index.mjs",
  "compatibility_date": "2026-09-03",
  "no_bundle": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/css/*",
      "!/js/*",
      "!/fonts/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  }
}
